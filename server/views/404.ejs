<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Rafael Izquierdo</title>
    <link href="/styles.css" rel="stylesheet">
</head>
<body class="bg-background text-foreground">
    <header class="fixed w-full bg-background/90 backdrop-blur-sm z-50 border-b border-border">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-4">
                <a href="/" class="text-xl font-semibold text-primary hover:text-accent transition-colors">
                    Rafael Izquierdo
                </a>
                <nav class="hidden lg:flex space-x-8">
                    <a href="/#home" class="text-primary hover:text-accent font-medium transition-colors">Inicio</a>
                    <a href="/#about" class="text-primary hover:text-accent font-medium transition-colors">Sobre Mí</a>
                    <a href="/#services" class="text-primary hover:text-accent font-medium transition-colors">Servicios</a>
                    <a href="/#testimonials" class="text-primary hover:text-accent font-medium transition-colors">Testimonios</a>
                    <a href="/blog" class="text-primary hover:text-accent font-medium transition-colors">Blog</a>
                    <a href="/#contact" class="bg-accent text-accent-foreground px-4 py-2 rounded-md hover:bg-accent/90 transition-colors">
                        Contacto
                    </a>
                </nav>
            </div>
        </div>
    </header>

    <main class="pt-24 min-h-screen flex items-center justify-center">
        <div class="container mx-auto px-4 text-center">
            <div class="max-w-2xl mx-auto">
                <div class="mb-12">
                    <h1 class="text-8xl md:text-9xl font-bold text-accent mb-6 opacity-80">404</h1>
                    <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6"><%= title %></h2>
                    <p class="text-muted-foreground text-lg leading-relaxed mb-8"><%= message %></p>
                </div>
                
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/blog" 
                       class="inline-flex items-center justify-center px-8 py-3 bg-accent text-accent-foreground font-semibold rounded-lg hover:bg-accent/90 transition-colors shadow-lg">
                        <svg class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                        </svg>
                        Ir al Blog
                    </a>
                    <a href="/" 
                       class="inline-flex items-center justify-center px-8 py-3 border border-border text-primary rounded-lg hover:bg-secondary transition-colors">
                        <svg class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                        Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-secondary border-t border-border">
        <div class="container mx-auto py-8 px-4 text-center">
            <p class="text-muted-foreground">© <%= new Date().getFullYear() %> Rafael Izquierdo. Todos los derechos reservados.</p>
        </div>
    </footer>
</body>
</html>