<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Rafael Izquierdo</title>
    <link href="/styles.css" rel="stylesheet">
</head>
<body class="bg-white">
    <nav class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/" class="text-xl font-bold text-gray-900">Rafael Izquierdo</a>
                </div>
                <div class="flex items-center space-x-8">
                    <a href="/" class="text-gray-700 hover:text-blue-600">Inicio</a>
                    <a href="/about" class="text-gray-700 hover:text-blue-600">Sobre mí</a>
                    <a href="/services" class="text-gray-700 hover:text-blue-600">Servicios</a>
                    <a href="/blog" class="text-gray-700 hover:text-blue-600">Blog</a>
                    <a href="/contact" class="text-gray-700 hover:text-blue-600">Contacto</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-4xl mx-auto px-4 py-16 text-center">
        <div class="mb-8">
            <h1 class="text-6xl font-bold text-gray-900 mb-4">404</h1>
            <h2 class="text-2xl font-semibold text-gray-700 mb-4"><%= title %></h2>
            <p class="text-gray-600 text-lg"><%= message %></p>
        </div>
        
        <div class="space-x-4">
            <a href="/blog" 
               class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                Ir al Blog
            </a>
            <a href="/" 
               class="inline-flex items-center px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
                Volver al Inicio
            </a>
        </div>
    </main>

    <footer class="bg-gray-50 border-t mt-16">
        <div class="max-w-7xl mx-auto py-8 px-4 text-center">
            <p class="text-gray-600">© <%= new Date().getFullYear() %> Rafael Izquierdo. Todos los derechos reservados.</p>
        </div>
    </footer>
</body>
</html>