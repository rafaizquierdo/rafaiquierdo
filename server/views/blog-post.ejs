<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %> - Rafael Izquierdo</title>
    <meta name="description" content="<%= post.excerpt || post.title %>">
    <meta name="author" content="<%= post.author %>">
    <link href="/styles.css" rel="stylesheet">
</head>
<body class="bg-white">
    <nav class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/" class="text-xl font-bold text-gray-900">Rafael Izquierdo</a>
                </div>
                <div class="flex items-center space-x-8">
                    <a href="/" class="text-gray-700 hover:text-blue-600">Inicio</a>
                    <a href="/about" class="text-gray-700 hover:text-blue-600">Sobre mí</a>
                    <a href="/services" class="text-gray-700 hover:text-blue-600">Servicios</a>
                    <a href="/blog" class="text-blue-600 font-medium">Blog</a>
                    <a href="/contact" class="text-gray-700 hover:text-blue-600">Contacto</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-4xl mx-auto px-4 py-12">
        <nav class="mb-8">
            <a href="/blog" class="inline-flex items-center text-blue-600 hover:text-blue-700">
                <svg class="mr-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Volver al blog
            </a>
        </nav>

        <article>
            <header class="mb-8">
                <h1 class="text-4xl font-bold text-gray-900 mb-4"><%= post.title %></h1>
                
                <div class="flex items-center text-gray-600 mb-6">
                    <time datetime="<%= post.date %>">
                        <%= new Date(post.date).toLocaleDateString('es-ES', { 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric' 
                        }) %>
                    </time>
                    <span class="mx-2">•</span>
                    <span><%= post.author %></span>
                </div>

                <% if (post.tags.length > 0) { %>
                    <div class="flex flex-wrap gap-2">
                        <% post.tags.forEach(tag => { %>
                            <span class="px-3 py-1 bg-blue-100 text-blue-800 text-sm rounded-full">
                                <%= tag %>
                            </span>
                        <% }) %>
                    </div>
                <% } %>
            </header>

            <div class="prose prose-lg prose-blue max-w-none">
                <%- post.htmlContent %>
            </div>
        </article>

        <footer class="mt-12 pt-8 border-t">
            <div class="text-center">
                <p class="text-gray-600 mb-4">¿Te ha resultado útil este artículo?</p>
                <a href="/contact" 
                   class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                    Contactar con Rafael
                </a>
            </div>
        </footer>
    </main>

    <footer class="bg-gray-50 border-t mt-16">
        <div class="max-w-7xl mx-auto py-8 px-4 text-center">
            <p class="text-gray-600">© <%= new Date().getFullYear() %> Rafael Izquierdo. Todos los derechos reservados.</p>
        </div>
    </footer>
</body>
</html>