<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog - Rafael Izquierdo</title>
    <meta name="description" content="Blog profesional de Rafael Izquierdo sobre transformación digital, liderazgo empresarial y emprendimiento.">
    <link href="/styles.css" rel="stylesheet">
</head>
<body class="bg-background text-foreground">
    <!-- Header elegante con el mismo estilo de la home -->
    <header class="fixed w-full bg-background/90 backdrop-blur-sm z-50 border-b border-border">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-4">
                <a href="/" class="text-xl font-semibold text-primary hover:text-accent transition-colors">
                    Rafael Izquierdo
                </a>
                <nav class="hidden lg:flex space-x-8">
                    <a href="/#home" class="text-primary hover:text-accent font-medium transition-colors">Inicio</a>
                    <a href="/#about" class="text-primary hover:text-accent font-medium transition-colors">Sobre Mí</a>
                    <a href="/#services" class="text-primary hover:text-accent font-medium transition-colors">Servicios</a>
                    <a href="/#testimonials" class="text-primary hover:text-accent font-medium transition-colors">Testimonios</a>
                    <a href="/blog" class="text-accent font-medium">Blog</a>
                    <a href="/#contact" class="bg-accent text-accent-foreground px-4 py-2 rounded-md hover:bg-accent/90 transition-colors">
                        Contacto
                    </a>
                </nav>
            </div>
        </div>
    </header>

    <!-- Hero section del blog -->
    <section class="pt-24 pb-16 bg-gradient-to-br from-background via-secondary/20 to-background">
        <div class="container mx-auto px-4 text-center">
            <h1 class="text-5xl md:text-6xl font-bold text-primary mb-6">
                Blog <span class="text-accent">Profesional</span>
            </h1>
            <p class="text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed">
                Insights sobre transformación digital, liderazgo empresarial y tendencias del sector tecnológico
            </p>
        </div>
    </section>

    <!-- Contenido principal -->
    <main class="container mx-auto px-4 py-16">
        <% if (posts.length === 0) { %>
            <div class="text-center py-16">
                <div class="max-w-md mx-auto">
                    <h2 class="text-3xl font-bold text-primary mb-4">Próximamente</h2>
                    <p class="text-muted-foreground text-lg">Estoy preparando contenido valioso para compartir contigo.</p>
                </div>
            </div>
        <% } else { %>
            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 max-w-7xl mx-auto">
                <% posts.forEach(post => { %>
                    <article class="group bg-card rounded-lg border border-border shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                        <div class="p-6">
                            <div class="flex items-center text-sm text-muted-foreground mb-4">
                                <time datetime="<%= post.date %>" class="font-medium">
                                    <%= new Date(post.date).toLocaleDateString('es-ES', { 
                                        year: 'numeric', 
                                        month: 'long', 
                                        day: 'numeric' 
                                    }) %>
                                </time>
                                <span class="mx-2">•</span>
                                <span><%= post.author %></span>
                            </div>
                            
                            <h2 class="text-xl font-bold text-card-foreground mb-3 leading-tight">
                                <a href="/blog/<%= post.slug %>" class="group-hover:text-accent transition-colors">
                                    <%= post.title %>
                                </a>
                            </h2>
                            
                            <% if (post.excerpt) { %>
                                <p class="text-muted-foreground mb-6 leading-relaxed line-clamp-3"><%= post.excerpt %></p>
                            <% } %>
                            
                            <% if (post.tags.length > 0) { %>
                                <div class="flex flex-wrap gap-2 mb-6">
                                    <% post.tags.forEach(tag => { %>
                                        <span class="px-3 py-1 bg-accent/10 text-accent text-xs font-medium rounded-full border border-accent/20">
                                            <%= tag %>
                                        </span>
                                    <% }) %>
                                </div>
                            <% } %>
                            
                            <a href="/blog/<%= post.slug %>" 
                               class="inline-flex items-center text-accent hover:text-accent/80 font-semibold group">
                                Leer artículo
                                <svg class="ml-2 w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                            </a>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </main>

    <!-- Footer elegante -->
    <footer class="bg-secondary border-t border-border mt-20">
        <div class="container mx-auto py-12 px-4">
            <div class="text-center">
                <h3 class="text-xl font-semibold text-primary mb-4">Rafael Izquierdo</h3>
                <p class="text-muted-foreground mb-6">CEO de V-Vision | Experto en Transformación Digital</p>
                <p class="text-sm text-muted-foreground">
                    © <%= new Date().getFullYear() %> Rafael Izquierdo. Todos los derechos reservados.
                </p>
            </div>
        </div>
    </footer>
</body>
</html>